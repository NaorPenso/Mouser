{
  "_about": {
    "name": "MX Master 4 - RatMode",
    "author": "Naor Penso",
    "device": "Logitech MX Master 4 over Bluetooth",
    "summary": "Recommended MX4 configuration for the RatMode fork. Apply with scripts/config-apply.sh mx4-ratmode; export UI changes back with scripts/config-export.sh mx4-ratmode.",
    "notes": {
      "actions_ring": "Sense Panel single click opens the Actions Ring (Mission Control, Play/Pause, Show Desktop, Launchpad); press and hold opens it until release.",
      "actions_ring_double": "Sense Panel click, then click and hold = Wispr Flow push-to-talk: hold:fn keeps Fn down for as long as the second press is held. hold:alt+grave (Opt+`) is the same Wispr Flow binding if Fn does not trigger it.",
      "double_press": "double_press_mode 'instant' fires the single action at once and cancels it (closes the ring) when a second press lands inside double_press_window_ms; 'wait' holds the single action back until the window passes. Tune both in settings.",
      "gesture": "Gesture button cuts.",
      "xbutton1": "Back button pastes.",
      "xbutton2": "Forward button copies.",
      "hscroll_left": "Thumb wheel left = next tab.",
      "hscroll_right": "Thumb wheel right = previous tab.",
      "mode_shift": "Wheel mode button switches ratchet / free spin."
    }
  },
  "version": 11,
  "active_profile": "default",
  "profiles": {
    "default": {
      "label": "MX4 RatMode (All Apps)",
      "apps": [],
      "mappings": {
        "middle": "none",
        "gesture": "cut",
        "gesture_left": "none",
        "gesture_right": "none",
        "gesture_up": "none",
        "gesture_down": "none",
        "xbutton1": "paste",
        "xbutton2": "copy",
        "hscroll_left": "next_tab",
        "hscroll_right": "prev_tab",
        "mode_shift": "switch_scroll_mode",
        "actions_ring": "activate_actions_ring",
        "actions_ring_left": "none",
        "actions_ring_right": "none",
        "actions_ring_up": "none",
        "actions_ring_down": "none",
        "gesture_tap": "none",
        "actions_ring_tap": "none",
        "mode_shift_tap": "none",
        "middle_tap": "none",
        "xbutton1_tap": "none",
        "xbutton2_tap": "select_all",
        "mode_shift_left": "none",
        "mode_shift_right": "none",
        "mode_shift_up": "none",
        "mode_shift_down": "none",
        "middle_left": "none",
        "middle_right": "none",
        "middle_up": "none",
        "middle_down": "none",
        "xbutton1_left": "none",
        "xbutton1_right": "none",
        "xbutton1_up": "none",
        "xbutton1_down": "none",
        "xbutton2_left": "none",
        "xbutton2_right": "none",
        "xbutton2_up": "none",
        "xbutton2_down": "none",
        "thumb_button": "none",
        "actions_ring_slots": [
          "mission_control",
          "play_pause",
          "show_desktop",
          "launchpad"
        ],
        "middle_double": "none",
        "gesture_double": "none",
        "xbutton1_double": "none",
        "xbutton2_double": "none",
        "mode_shift_double": "none",
        "dpi_switch_double": "none",
        "actions_ring_double": "hold:fn",
        "thumb_button_double": "none"
      },
      "button_haptic": {}
    }
  },
  "settings": {
    "start_minimized": true,
    "start_at_login": true,
    "hscroll_threshold": 0.1,
    "invert_hscroll": false,
    "invert_vscroll": false,
    "dpi": 1000,
    "smart_shift_mode": "ratchet",
    "smart_shift_enabled": false,
    "smart_shift_threshold": 25,
    "scroll_force": 50,
    "gesture_threshold": 25,
    "gesture_commit_window_ms": 400,
    "gesture_settle_ms": 90,
    "gesture_cross_ratio": 0.5,
    "appearance_mode": "system",
    "debug_mode": false,
    "device_layout_overrides": {},
    "haptic_level": 2,
    "haptic_enabled": true,
    "action_haptic": [],
    "button_haptic": [],
    "haptic_dedup": true,
    "ignore_trackpad": true,
    "screenshot_directory": "",
    "wheel_divert": "auto",
    "force_sensitivity": null,
    "actions_ring_hold_ms": 250,
    "actions_ring_hover_haptic": true,
    "actions_ring_use_global": true,
    "actions_ring_slots": [
      "mission_control",
      "play_pause",
      "show_desktop",
      "launchpad"
    ],
    "double_press_mode": "wait",
    "double_press_window_ms": 300
  }
}
